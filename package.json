{
  "type": "module",
  "scripts": {
    "build": "sh scripts/build.sh",
    "publish": "sh scripts/publish.sh",
    "new-plugin": "node scripts/new-plugin.ts && pnpm install",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:update": "vitest run -u",
    "lint": "oxlint . --fix",
    "lint:check": "oxlint .",
    "fmt": "oxfmt ."
  },
  "dependencies": {
    "@lumeland/lume": "workspace:*",
    "jszip": "^3.10.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "tar-stream": "^3.2.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.10.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.10.1"
}
