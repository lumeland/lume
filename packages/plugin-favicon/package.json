{
  "name": "@lumeland/plugin-favicon",
  "version": "1.0.0-beta-1",
  "description": "Plugin to create favicons automatically using a svg file as the source",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/mod.ts",
    "./*.ts": "./src/*.ts"
  },
  "scripts": {
    "build": "rm -rf build && tsc -p .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:update": "vitest run -u"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "ico-endec": "^0.1.6",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@lumeland/plugin-svgo": "workspace:^",
    "@lumeland/testing": "workspace:*",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "@lumeland/core": "workspace:*"
  }
}
