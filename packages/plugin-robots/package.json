{
  "name": "@lumeland/plugin-robots",
  "version": "1.0.0-beta-9",
  "description": "Plugin to create the robots.txt file automatically",
  "keywords": [
    "lume-plugin"
  ],
  "homepage": "https://lume.land/plugins/robots/",
  "license": "MIT",
  "author": "Óscar Otero",
  "files": [
    "build",
    "CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/mod.ts",
    "./*.ts": "./src/*.ts"
  },
  "scripts": {
    "build": "rm -rf build && tsc -p .",
    "update-robots": "curl -L -o src/ai-robots.json 'https://cdn.jsdelivr.net/gh/ai-robots-txt/ai.robots.txt@latest/robots.json'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:update": "vitest run -u"
  },
  "devDependencies": {
    "@lumeland/testing": "workspace:^",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@lumeland/core": "workspace:^"
  }
}
