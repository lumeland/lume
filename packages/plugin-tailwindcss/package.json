{
  "name": "@lumeland/plugin-tailwindcss",
  "version": "1.0.0-beta-4",
  "description": "Plugin to use Tailwind to create the CSS styles",
  "homepage": "https://lume.land/plugins/tailwindcss/",
  "license": "MIT",
  "author": "Óscar Otero",
  "files": [
    "build",
    "CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/mod.ts",
    "./*.ts": "./src/*.ts"
  },
  "scripts": {
    "build": "rm -rf build && tsc -p .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:update": "vitest run -u"
  },
  "dependencies": {
    "@lumeland/plugin-source-maps": "workspace:^",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/oxide": "^4.3.3",
    "lightningcss": "^1.33.0"
  },
  "devDependencies": {
    "@lumeland/testing": "workspace:^",
    "@types/node": "^26.6.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@lumeland/core": "workspace:^"
  }
}
