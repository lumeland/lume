{
  "name": "@lumeland/plugin-epub",
  "version": "1.0.0-beta-2",
  "description": "Output a .epub file with the site",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/mod.ts",
    "./*.ts": "./src/*.ts"
  },
  "scripts": {
    "build": "rm -rf build && tsc -p .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:update": "vitest run -u"
  },
  "dependencies": {
    "@lowlighter/xml": "^8.0.1",
    "@lumeland/plugin-nav": "workspace:^",
    "@zip.js/zip.js": "^2.23.0",
    "deno-std": "^1.5.1"
  },
  "devDependencies": {
    "@lumeland/testing": "workspace:*",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "@lumeland/core": "workspace:*"
  }
}
