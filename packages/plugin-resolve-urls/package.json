{
  "name": "@lumeland/plugin-resolve-urls",
  "version": "1.0.0-beta-1",
  "description": "Plugin to resolve all URLs pointing to source files",
  "license": "MIT",
  "files": [
    "build",
    "CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/mod.ts",
    "./*.ts": "./src/*.ts"
  },
  "scripts": {
    "build": "rm -rf build && tsc -p .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:update": "vitest run -u"
  },
  "dependencies": {
    "@lumeland/plugin-modify-urls": "workspace:^"
  },
  "devDependencies": {
    "@lumeland/plugin-slugify-urls": "workspace:^",
    "@lumeland/testing": "workspace:*",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@lumeland/core": "workspace:*"
  }
}
