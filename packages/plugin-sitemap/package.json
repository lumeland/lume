{
  "name": "@lumeland/plugin-sitemap",
  "version": "1.0.0-beta-2",
  "description": "Plugin to generate a sitemap automatically",
  "license": "MIT",
  "files": [
    "build",
    "CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/mod.ts",
    "./*.ts": "./src/*.ts"
  },
  "scripts": {
    "build": "rm -rf build && tsc -p .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:update": "vitest run -u"
  },
  "dependencies": {
    "@lowlighter/xml": "^8.0.1"
  },
  "devDependencies": {
    "@lumeland/plugin-extract-date": "workspace:^",
    "@lumeland/plugin-filter-pages": "workspace:^",
    "@lumeland/plugin-multilanguage": "workspace:^",
    "@lumeland/plugin-redirects": "workspace:^",
    "@lumeland/testing": "workspace:*",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "@lumeland/core": "workspace:*"
  }
}
