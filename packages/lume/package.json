{
  "name": "@lumeland/lume",
  "version": "4.0.0-beta-8",
  "description": "A fast and flexible static site generator",
  "homepage": "https://lume.land/",
  "license": "MIT",
  "author": "Óscar Otero",
  "bin": {
    "lume": "./bin.ts"
  },
  "files": [
    "build",
    "CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/mod.ts",
    "./*.ts": "./src/*.ts"
  },
  "scripts": {
    "build": "rm -rf build && tsc -p ."
  },
  "dependencies": {
    "@lumeland/core": "workspace:^",
    "@lumeland/plugin-cms": "workspace:^",
    "@lumeland/plugin-dev": "workspace:^",
    "@lumeland/plugin-json": "workspace:^",
    "@lumeland/plugin-markdown": "workspace:^",
    "@lumeland/plugin-modules": "workspace:^",
    "@lumeland/plugin-paginate": "workspace:^",
    "@lumeland/plugin-search": "workspace:^",
    "@lumeland/plugin-toml": "workspace:^",
    "@lumeland/plugin-url": "workspace:^",
    "@lumeland/plugin-vento": "workspace:^",
    "@lumeland/plugin-yaml": "workspace:^",
    "cac": "^7.1.0",
    "deno-std": "^1.6.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@lumeland/ssx": "^0.1.16"
  },
  "allowScripts": {
    "fsevents": false
  }
}
