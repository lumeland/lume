{
  "name": "@lumeland/plugin-esbuild",
  "version": "1.0.0-beta-3",
  "description": "Plugin to bundle JavaScript, TypeScript and JSX files using esbuild library",
  "homepage": "https://lume.land/plugins/esbuild/",
  "license": "MIT",
  "author": "Óscar Otero",
  "files": [
    "build",
    "CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/mod.ts",
    "./*.ts": "./src/*.ts"
  },
  "scripts": {
    "build": "rm -rf build && tsc -p .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:update": "vitest run -u"
  },
  "dependencies": {
    "@lumeland/plugin-source-maps": "workspace:^",
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "@lumeland/testing": "workspace:^",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@lumeland/core": "workspace:^"
  }
}
