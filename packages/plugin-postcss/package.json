{
  "name": "@lumeland/plugin-postcss",
  "version": "1.0.0-beta-4",
  "description": "Plugin to transform the CSS code with PostCSS",
  "homepage": "https://lume.land/plugins/postcss/",
  "license": "MIT",
  "author": "Óscar Otero",
  "files": [
    "build",
    "CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/mod.ts",
    "./*.ts": "./src/*.ts"
  },
  "scripts": {
