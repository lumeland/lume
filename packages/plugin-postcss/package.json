  },
  "devDependencies": {
    "@lumeland/testing": "workspace:^",
    "@types/node": "^26.6.5",
    "@types/postcss-import": "^14.0.3",
    "cssnano": "^9.9.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@lumeland/core": "workspace:^"
  }
}
