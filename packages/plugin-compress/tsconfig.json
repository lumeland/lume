{
  "compilerOptions": {
    "types": ["node"],
    "moduleResolution": "NodeNext",
    "module": "NodeNext",
    "allowImportingTsExtensions": true,
    "target": "ES2025",
    "lib": [
      "ES2025",
      "ESNext.Iterator",
      "DOM",
      "DOM.Iterable",
      "DOM.AsyncIterable",
      "ESNext.Temporal"
    ],
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "outDir": "build",
    "rootDir": ".",
    "declaration": true
  },
  "exclude": ["tests", "build"]
}
