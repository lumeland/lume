{
  "name": "@lumeland/plugin-unocss",
  "version": "1.0.0-beta-3",
  "description": "Plugin to use UnoCSS to create the CSS styles",
  "homepage": "https://lume.land/plugins/unocss/",
  "license": "MIT",
  "author": "Óscar Otero",
  "files": [
    "build",
    "CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/mod.ts",
    "./*.ts": "./src/*.ts"
  },
  "scripts": {
    "build": "rm -rf build && tsc -p .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:update": "vitest run -u"
  },
  "dependencies": {
    "@unocss/config": "^66.11.0",
    "@unocss/core": "^66.11.0",
    "@unocss/preset-wind3": "^66.11.0",
    "@unocss/reset": "^66.11.0",
    "@unocss/transformer-directives": "^66.11.0",
    "@unocss/transformer-variant-group": "^66.11.0",
    "magic-string": "^1.4.3"
  },
  "devDependencies": {
    "@lumeland/testing": "workspace:*",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@lumeland/core": "workspace:*"
  }
}
