    "test:watch": "vitest",
    "test:update": "vitest run -u"
  },
  "dependencies": {
    "mermaid": "^13.0.0-alpha.3"
  },
  "devDependencies": {
    "@lumeland/testing": "workspace:^",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "peerDependencies": {
    "@lumeland/core": "workspace:^"
  }
}
