{
  "name": "@lumeland/plugin-mermaid",
  "version": "1.0.0-alpha.1",
  "description": "Plugin to render mermaid diagrams at build time.",
  "keywords": [
    "lume-plugin"
  ],
  "license": "MIT",
  "files": [
    "build",
    "CHANGELOG.md"
  ],
  "type": "module",
