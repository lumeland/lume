{
  "compilerOptions": {
    "types": ["node"],
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "jsxImportSource": "@lumeland/ssx",
    "module": "NodeNext",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "target": "ES2022",
    "erasableSyntaxOnly": true,
    "lib": [
      "ES2022",
      "ESNext.Iterator",
      "DOM",
      "DOM.Iterable",
      "DOM.AsyncIterable",
      "ESNext.Temporal"
    ]
  }
}
